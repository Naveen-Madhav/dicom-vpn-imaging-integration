    "XR_ROOM_01":    [ "XR_ROOM_01",    "10.100.10.23", 11112 ],
    "EDGE_DICOM_GW": [ "EDGE_DICOM_GW", "10.100.10.15", 11112 ],
    "CENTRAL_ROUTER":[ "CENTRAL_ROUTER","10.200.20.10", 11112 ],
    "RAD_DESK_01":   [ "RAD_DESK_01",   "10.200.20.101", 11114 ]
  }
}
